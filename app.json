{
  "expo": {
    "name": "HabitFlow",
    "slug": "HabitFlow",
    "version": "2.4.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ianskaitis.HabitFlow"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ianskaitis.HabitFlow",
      "versionCode": 20,
      "allowBackup": true,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WeeklyHabitWidget",
              "label": "Habit - Weekly",
              "description": "Shows your habit progress for the current week",
              "minWidth": "180dp",
              "minHeight": "70dp",
              "previewImage": "./assets/weekly_widget_preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "MonthlyHabitWidget",
              "label": "Habit - Monthly",
              "description": "Shows your habit progress for the past month",
              "minWidth": "180dp",
              "minHeight": "140dp",
              "previewImage": "./assets/monthly_widget_preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "GitHubHabitWidget",
              "label": "Habit - GitHub Grid",
              "description": "Shows your habit progress in a GitHub contribution graph style",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "previewImage": "./assets/github_widget_preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "SmallHabitWidget",
              "label": "Habit - Day Check",
              "description": "1×1 tap to toggle today's habit",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "previewImage": "./assets/small_widget_preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec8f799b-14e4-4544-999b-46403a56c8c5"
      }
    }
  }
}